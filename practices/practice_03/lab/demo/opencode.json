{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/itmo-agent",
  "small_model": "ollama/itmo-agent",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "itmo-agent": {
          "name": "ITMO local 64k",
          "limit": {
            "context": 65536,
            "output": 4096
          }
        }
      }
    }
  },
  "agent": {
    "local-guide": {
      "description": "Read-only local repository assistant",
      "mode": "primary",
      "prompt": "{file:./repo-system.txt}",
      "steps": 8,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    },
    "local-guide-b": {
      "description": "Read-only local repository assistant (Prompt B)",
      "mode": "primary",
      "prompt": "{file:./repo-system-b.txt}",
      "steps": 8,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    }
  }
  ,
  "mcp": { "servers": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "disabled": false,
      "codemode": false
    }
  }}
  ,
  "notes": {
    "mcp_context7": {
      "usage_examples": [
        {
          "description": "Запрос документации по FastAPI в нужной версии",
          "command": "use context7: query-docs 'FastAPI response validation'",
          "expected": "Ссылки и выдержки из документации FastAPI"
        },
        {
          "description": "Ошибочный запрос с неизвестным ресурсом",
          "command": "use context7: query-docs 'nonexistent-component-xyz'",
          "expected": "Сообщение об отсутствии результата или корректная ошибка"
        }
      ]
    }
  }
}
